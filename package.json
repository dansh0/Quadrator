{
  "name": "quadrator",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev:ui": "pnpm --filter @quadrator/ui dev",
    "dev:desktop": "pnpm --filter @quadrator/ui build && pnpm --filter @quadrator/desktop start",
    "package:desktop": "pnpm --filter @quadrator/ui build && pnpm --filter @quadrator/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "fast-check": "^4.8.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
